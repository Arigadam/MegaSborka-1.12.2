        "2.0.6": "\u00a7a+\u00a7r Add more decimal formats \n\u00a7e*\u00a7r Some fix to mixins \n\u00a7e*\u00a7r Fixed bug in NumberUtils with empty char",
        "2.0.5": "\u00a7e*\u00a7r Update NumberUtils and JsonUtils",
        "2.0.4": "\u00a7e*\u00a7r Switch ChatScreenRegistry to use forge event",
        "2.0.3": "\u00a7e*\u00a7r Update sound event registry",
        "2.0.2": "\u00a7e*\u00a7r Fixed lag spike when in the Enchantment Table GUI, Closed #6 \n\u00a7e*\u00a7r Downgrade mixin to 0.8",
        "2.0.1": "\u00a7e*\u00a7r Update and remove registry helpers\n \u00a7e*\u00a7r Fixed bad jar compile",
        "2.0.0": "First release for Minecraft 1.14.4!"
    },
    "1.12.2": {
        "1.2.0": "\u00a7e*\u00a7r Include Mixin into the mod",
        "1.1.11": "\u00a7e*\u00a7r Required MixinBooter \n\u00a7e*\u00a7r Internal mixin updates",
        "1.1.10": "\u00a7e*\u00a7r Fixed crash with vivecraft, closed #8",
        "1.1.9": "\u00a7e*\u00a7r Attempt to fix crash with spongeforge \n\u00a74-\u00a7r Removed Invalid Fingerprint check",
        "1.1.8": "\u00a7e*\u00a7r Fixed crash with spongeforge",
        "1.1.7": "\u00a7e*\u00a7r Performance improvement for WeatherTickEvent \n\u00a7e*\u00a7r Clean up mixins",
        "1.1.6": "\u00a7e*\u00a7r Fixed mixin issue",
        "1.1.5": "\u00a7e*\u00a7r Update to Latest Forge 1.12.2",
        "1.1.4": "\u00a7e*\u00a7r Fixed Mixin Boostrap in Dev Environment",
        "1.1.3": "\u00a7e*\u00a7r Fixed conflict with SpongeForge \n\u00a7e*\u00a7r Fixed crash with VanillaFix or RandomPatches, Fixes #2",
        "1.1.2": "\u00a7e*\u00a7r Attempt to fix incompatibility with RandomPatches mod. #2",
        "1.1.1": "\u00a7e*\u00a7r Fixed incompatible with Dynamic Surrounding, Fixes #1",
        "1.1.0": "\u00a7a+\u00a7r Added New API \n\u00a7e*\u00a7r Update Forge version \n\u00a7e*\u00a7r Using Mixin Framework, please check if it incompatible with other mods. \n\u00a7e*\u00a7r Fixed ColoredFontRenderer alpha color.",
        "1.0.5": "\u00a7e*\u00a7r Fixed Config Manager issue",
        "1.0.4": "\u00a7a+\u00a7r Added Replace GUI Ingame config to prevent incompatibility for other mods",
        "1.0.3": "\u00a7a+\u00a7r Added IGuiChat API for Indicatia and YouTube Chat",
        "1.0.2": "\u00a7a+\u00a7r Added Overlay Message with Delay \n\u00a7e*\u00a7r Update Colored Font Renderer \n\u00a74-\u00a7r Removed change log from Version Checker",
        "1.0.1": "\u00a7a+\u00a7r Added Colored Font for Unicode \n\u00a7e*\u00a7r Cleanup Remapper info log \n\u00a7e*\u00a7r Bump required Forge to 14.23.4.2705 \n\u00a7e*\u00a7r Fixed CurseForge URL",
